template<class F> void bindFunction(HMODULE module,F& target,const char* name){
    FARPROC p=GetProcAddress(module,name);
    if(!p)throw std::runtime_error(string("Missing Windows API: ")+name);
    static_assert(sizeof(p)==sizeof(target),"Function pointer size mismatch");
    memcpy(&target,&p,sizeof(p));
}
