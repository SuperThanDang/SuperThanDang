string readFile(const wstring& path){
    FileHandle f(CreateFileW(path.c_str(),GENERIC_READ,FILE_SHARE_READ,nullptr,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,nullptr));
    if(f.h==INVALID_HANDLE_VALUE)throw winError("Không mở được file dữ liệu");
    LARGE_INTEGER n{};
    if(!GetFileSizeEx(f.h,&n)||n.QuadPart<0||n.QuadPart>64*1024*1024)throw std::runtime_error("File lịch sử quá lớn hoặc không hợp lệ.");
