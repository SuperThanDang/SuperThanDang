    if(j.names.empty()&&textModel(j.lastGood))return {j.lastGood};
    if(j.names.empty())j.names=loadModels(j);
    auto names=j.names;
    std::sort(names.begin(),names.end(),[&](const string& a,const string& b){int x=rankModel(a,j.fast),y=rankModel(b,j.fast);return x!=y?x<y:a>b;});
    std::vector<string> result;
