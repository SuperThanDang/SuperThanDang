        }
    }
    bool hasText()const{return text.find_first_not_of(" \t\r\n")!=string::npos;}
    bool success()const{return hasText()&&finish=="STOP"&&block.empty()&&!media&&!tools;}
    bool retryable()const{return !hasText()&&block.empty()&&!media&&!tools&&(finish=="STOP"||finish=="MAX_TOKENS");}
    string diagnostic()const{return "finishReason="+finish+", block="+block+", thought="+std::to_string(thoughts)+", media="+std::to_string(media)+", functionCall="+std::to_string(tools);}
