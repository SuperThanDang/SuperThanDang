struct Pixels {UINT w=0,h=0;std::vector<uint8_t> bytes;};
Pixels readPixels(IWICImagingFactory* factory,IWICBitmapSource* source){
    UINT w=0,h=0;checkHr(source->GetSize(&w,&h),"Không đọc được kích thước ảnh");
    if(!w||!h||w>30000||h>30000||(uint64_t)w*h>100000000)throw std::runtime_error("Ảnh quá lớn (tối đa 100 triệu điểm ảnh).");
    double scale=std::min(1.0,1600.0/std::max(w,h));Pixels result;
    result.w=std::max(1u,(UINT)(w*scale));result.h=std::max(1u,(UINT)(h*scale));
    ComPtr<IWICBitmapScaler> scaler;checkHr(factory->CreateBitmapScaler(scaler.put()),"Không tạo được bộ thu nhỏ ảnh");
    checkHr(scaler->Initialize(source,result.w,result.h,WICBitmapInterpolationModeFant),"Không thu nhỏ được ảnh");
    ComPtr<IWICFormatConverter> convert;checkHr(factory->CreateFormatConverter(convert.put()),"Không tạo được bộ đổi ảnh");
    checkHr(convert->Initialize(scaler.p,GUID_WICPixelFormat32bppBGRA,WICBitmapDitherTypeNone,nullptr,0,WICBitmapPaletteTypeCustom),"Không đổi được ảnh");
    result.bytes.resize((size_t)result.w*result.h*4);
    checkHr(convert->CopyPixels(nullptr,result.w*4,(UINT)result.bytes.size(),result.bytes.data()),"Không đọc được điểm ảnh");
    // Flatten transparency on white for predictable previews and model input.
    for(size_t i=0;i<result.bytes.size();i+=4){unsigned a=result.bytes[i+3];for(int k=0;k<3;++k)result.bytes[i+k]=(uint8_t)((result.bytes[i+k]*a+255*(255-a)+127)/255);result.bytes[i+3]=255;}
    return result;
}
Pixels decodeImageFile(const wstring& path){
    WIN32_FILE_ATTRIBUTE_DATA info{};
    if(!GetFileAttributesExW(path.c_str(),GetFileExInfoStandard,&info))throw winError("Không đọc được file ảnh");
    if(info.dwFileAttributes&FILE_ATTRIBUTE_DIRECTORY||info.nFileSizeHigh||info.nFileSizeLow>25*1024*1024)throw std::runtime_error("Chọn một file ảnh nhỏ hơn 25 MB.");
    ComPtr<IWICImagingFactory> f;makeImaging(f);ComPtr<IWICBitmapDecoder> decoder;ComPtr<IWICBitmapFrameDecode> frame;
    checkHr(f->CreateDecoderFromFilename(path.c_str(),nullptr,GENERIC_READ,WICDecodeMetadataCacheOnDemand,decoder.put()),"File không phải ảnh được Windows hỗ trợ");
    checkHr(decoder->GetFrame(0,frame.put()),"Không đọc được khung ảnh");return readPixels(f.p,frame.p);
}
Pixels decodeImageMemory(const uint8_t* data,size_t length){
    if(!length||length>25*1024*1024)throw std::runtime_error("Ảnh Clipboard quá lớn hoặc rỗng.");
    ComPtr<IWICImagingFactory> f;makeImaging(f);ComPtr<IWICStream> stream;ComPtr<IWICBitmapDecoder> decoder;ComPtr<IWICBitmapFrameDecode> frame;
    checkHr(f->CreateStream(stream.put()),"Không tạo được luồng ảnh");
    checkHr(stream->InitializeFromMemory((BYTE*)data,(DWORD)length),"Không đọc được ảnh Clipboard");
    checkHr(f->CreateDecoderFromStream(stream.p,nullptr,WICDecodeMetadataCacheOnDemand,decoder.put()),"Ảnh Clipboard không hợp lệ");
    checkHr(decoder->GetFrame(0,frame.put()),"Không đọc được ảnh Clipboard");return readPixels(f.p,frame.p);
}
std::vector<uint8_t> encodePng(const std::vector<uint8_t>& bgra,int w,int h){
    if(w<=0||h<=0||(size_t)w*h*4!=bgra.size())throw std::runtime_error("Dữ liệu ảnh không hợp lệ.");
    ComPtr<IWICImagingFactory> f;makeImaging(f);ComPtr<IStream> stream;
    checkHr(CreateStreamOnHGlobal(nullptr,TRUE,stream.put()),"Không tạo được bộ nhớ ảnh");
    ComPtr<IWICBitmapEncoder> encoder;ComPtr<IWICBitmapFrameEncode> frame;
    checkHr(f->CreateEncoder(GUID_ContainerFormatPng,nullptr,encoder.put()),"Không tạo được bộ nén PNG");
    checkHr(encoder->Initialize(stream.p,WICBitmapEncoderNoCache),"Không khởi tạo được PNG");
    checkHr(encoder->CreateNewFrame(frame.put(),nullptr),"Không tạo được khung PNG");
    checkHr(frame->Initialize(nullptr),"Không khởi tạo được khung PNG");checkHr(frame->SetSize((UINT)w,(UINT)h),"Không đặt được kích thước PNG");
    WICPixelFormatGUID format=GUID_WICPixelFormat24bppBGR;
    checkHr(frame->SetPixelFormat(&format),"Không đặt được định dạng PNG");
    if(memcmp(&format,&GUID_WICPixelFormat24bppBGR,sizeof(format)))throw std::runtime_error("Windows không hỗ trợ PNG 24-bit.");
    std::vector<uint8_t> bgr((size_t)w*h*3);
    for(size_t i=0,j=0;i<bgra.size();i+=4,j+=3){bgr[j]=bgra[i];bgr[j+1]=bgra[i+1];bgr[j+2]=bgra[i+2];}
    checkHr(frame->WritePixels((UINT)h,(UINT)w*3,(UINT)bgr.size(),bgr.data()),"Không ghi được ảnh PNG");
    checkHr(frame->Commit(),"Không hoàn tất khung PNG");checkHr(encoder->Commit(),"Không hoàn tất ảnh PNG");
    STATSTG stat{};checkHr(stream->Stat(&stat,STATFLAG_NONAME),"Không đọc được dung lượng PNG");
    if(stat.cbSize.QuadPart>16*1024*1024)throw std::runtime_error("Ảnh PNG quá lớn.");
    LARGE_INTEGER zero{};checkHr(stream->Seek(zero,STREAM_SEEK_SET,nullptr),"Không đọc lại được PNG");
    std::vector<uint8_t> result((size_t)stat.cbSize.QuadPart);ULONG got=0;
    checkHr(stream->Read(result.data(),(ULONG)result.size(),&got),"Không đọc đủ dữ liệu PNG");
    if(got!=result.size())throw std::runtime_error("Dữ liệu PNG chưa đầy đủ.");
    return result;
}

// All screen/GDI operations stay on the UI thread; restore the window on every exit.
std::vector<uint8_t> capture(int x,int y,int w,int h) {
    if(w<2 || h<2) throw std::runtime_error("Vùng chụp quá nhỏ. Hãy chọn lại hai góc.");
    struct CaptureResources {
        bool visible; HDC screen=nullptr, dc=nullptr; HBITMAP bitmap=nullptr; HGDIOBJ old=nullptr;
        explicit CaptureResources(bool v):visible(v){}
        ~CaptureResources(){
            if(old && old!=HGDI_ERROR) SelectObject(dc,old);
            if(bitmap) DeleteObject(bitmap);
            if(dc) DeleteDC(dc);
            if(screen) ReleaseDC(nullptr,screen);
            if(visible) ShowWindow(mainWnd,SW_SHOWNA);
        }
    } r(IsWindowVisible(mainWnd)!=FALSE);
    if(r.visible){ ShowWindow(mainWnd,SW_HIDE);DwmFlush(); }
    double scale=std::min(1.0,1600.0/std::max(w,h));
    int dw=std::max(1,(int)(w*scale)), dh=std::max(1,(int)(h*scale));
    r.screen=GetDC(nullptr);
    if(!r.screen) throw winError("Không lấy được màn hình");
    r.dc=CreateCompatibleDC(r.screen);
    r.bitmap=CreateCompatibleBitmap(r.screen,dw,dh);
    if(!r.dc || !r.bitmap) throw winError("Không tạo được ảnh màn hình");
    r.old=SelectObject(r.dc,r.bitmap);
    if(!r.old || r.old==HGDI_ERROR) throw winError("Không chọn được bitmap");
    if(!SetStretchBltMode(r.dc,HALFTONE) || !SetBrushOrgEx(r.dc,0,0,nullptr))
        throw winError("Không chuẩn bị được bộ chụp ảnh");
    if(!StretchBlt(r.dc,0,0,dw,dh,r.screen,x,y,w,h,SRCCOPY|CAPTUREBLT))
        throw winError("Chụp màn hình thất bại");
    if(!SelectObject(r.dc,r.old))throw winError("Không bỏ chọn được bitmap");
    r.old=nullptr; // Deselect BEFORE GetDIBits.
    BITMAPINFO info{};info.bmiHeader.biSize=sizeof(BITMAPINFOHEADER);
    info.bmiHeader.biWidth=dw;info.bmiHeader.biHeight=-dh;info.bmiHeader.biPlanes=1;
    info.bmiHeader.biBitCount=32;info.bmiHeader.biCompression=BI_RGB;
    std::vector<uint8_t> pixels((size_t)dw*dh*4);
    if(GetDIBits(r.screen,r.bitmap,0,(UINT)dh,pixels.data(),&info,DIB_RGB_COLORS)!=dh)
        throw winError("Không đọc được ảnh màn hình");
    return encodePng(pixels,dw,dh);
}


// JSON serialization preserves returned thoughtSignature fields.
json objectJson(){json j;j.type=json::Object;return j;}
json arrayJson(){json j;j.type=json::Array;return j;}
json stringJson(const string& s){json j;j.type=json::String;j.text=s;return j;}
string dumpJson(const json& j){
    if(j.type==json::String)return quoteJson(j.text);
    if(j.type==json::Number)return j.text;
    if(j.type==json::Boolean)return j.flag?"true":"false";
    if(j.type==json::Null)return "null";
    string s=j.type==json::Array?"[":"{";bool first=true;
    if(j.type==json::Array){for(const auto& v:j.array){if(!first)s+=',';first=false;s+=dumpJson(v);}}
    else for(const auto& kv:j.object){if(!first)s+=',';first=false;s+=quoteJson(kv.first)+":"+dumpJson(kv.second);}
    return s+(j.type==json::Array?']':'}');
}
json textContent(const string& role,const string& text){
    json c=objectJson(),p=objectJson(),a=arrayJson();
    p.object["text"]=stringJson(text);a.array.push_back(p);
    c.object["role"]=stringJson(role);c.object["parts"]=a;return c;
}
struct ReplyVersion {string answer,model,state;json content;};
bool validReplyState(const string& state){return state=="ok"||state=="partial"||state=="error"||state=="interrupted";}
struct Turn {string question,answer,model,time,image,state="pending";json content;std::vector<ReplyVersion> replies;size_t replyIndex=0;};
ReplyVersion replyOf(const Turn& t){ReplyVersion r;r.answer=t.answer;r.model=t.model;r.state=t.state;r.content=t.content;return r;}
void chooseReply(Turn& t,size_t index){
    if(index>=t.replies.size())throw std::runtime_error("Phiên bản trả lời không còn tồn tại.");
    const auto& r=t.replies[index];t.answer=r.answer;t.model=r.model;t.state=r.state;t.content=r.content;t.replyIndex=index;
}
void rememberReply(Turn& t){t.replies.push_back(replyOf(t));t.replyIndex=t.replies.size()-1;}
Turn contextTurn(const Turn& t){Turn c;c.question=t.question;c.answer=t.answer;c.model=t.model;c.time=t.time;c.image=t.image;c.state=t.state;c.content=t.content;return c;}
string replyJson(const ReplyVersion& r){return "{\"answer\":"+quoteJson(r.answer)+",\"model\":"+quoteJson(r.model)+",\"state\":"+quoteJson(r.state)+",\"content\":"+dumpJson(r.content)+"}";}

