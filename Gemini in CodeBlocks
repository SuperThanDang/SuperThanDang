                    if(!job->list)for(auto& c:chats)if(c.id==job->chatId&&job->turnIndex<c.turns.size()){c.turns[job->turnIndex].answer=utf8(text);c.turns[job->turnIndex].state="interrupted";if(!c.turns[job->turnIndex].replies.empty())rememberReply(c.turns[job->turnIndex]);}}
