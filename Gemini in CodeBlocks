struct FileHandle {
    HANDLE h;explicit FileHandle(HANDLE v):h(v){}
    ~FileHandle(){if(h && h!=INVALID_HANDLE_VALUE)CloseHandle(h);}
    FileHandle(const FileHandle&)=delete;FileHandle& operator=(const FileHandle&)=delete;
