                    if(interactiveResize&&!closePending)return 0;
                    if(WaitForSingleObject(worker,0)==WAIT_OBJECT_0)finishJob();
                    else if(!closePending&&IsWindowVisible(hwnd)&&!IsIconic(hwnd)){
                        wstring note,delta;bool reset=false;
                        if(job->drain(note,delta,reset)){
                            status(note);
