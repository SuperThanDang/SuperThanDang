        t.answer=result.ok?result.answer:result.error;
        t.state=result.ok?(result.complete?"ok":"partial"):"error";
        if(result.retrying||!t.replies.empty())rememberReply(t);
        if(!result.retrying&&(!result.ok||!result.complete)&&c.draft.empty()){c.draft=result.originalDraft;c.draftImage=result.originalImage;}
        break;
    }
}
