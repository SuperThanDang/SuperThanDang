wstring wide(const string& s) {
    if(s.empty())return {};
    DWORD flags=MB_ERR_INVALID_CHARS;
    int n=MultiByteToWideChar(CP_UTF8,flags,s.data(),(int)s.size(),nullptr,0);
    if(n<=0){flags=0;n=MultiByteToWideChar(CP_UTF8,flags,s.data(),(int)s.size(),nullptr,0);}
    if(n<=0)return L"[UTF-8 decode error]";
    wstring r(n,L'\0');
    MultiByteToWideChar(CP_UTF8,flags,s.data(),(int)s.size(),&r[0],n);
    return r;
}
string utf8(const wstring& s) {
    if(s.empty()) return {};
    int n=WideCharToMultiByte(CP_UTF8,0,s.data(),(int)s.size(),nullptr,0,nullptr,nullptr);
    string r(n,'\0');
    if(n) WideCharToMultiByte(CP_UTF8,0,s.data(),(int)s.size(),&r[0],n,nullptr,nullptr);
    return r;
}
