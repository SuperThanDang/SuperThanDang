        }
        client.reset();for(HGDIOBJ o:{(HGDIOBJ)uiFont,(HGDIOBJ)titleFont,(HGDIOBJ)smallFont,(HGDIOBJ)pageBrush,(HGDIOBJ)sideBrush,(HGDIOBJ)whiteBrush})if(o)DeleteObject(o);return result<0?1:(int)msg.wParam;
    }catch(const std::exception& e){MessageBoxW(nullptr,wide(e.what()).c_str(),L"Gemini Desktop",MB_ICONERROR);return 1;}
