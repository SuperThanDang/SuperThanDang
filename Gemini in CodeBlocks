string historyJson(){
    // Serialize directly: do not clone every turn and thought signature into a JSON tree.
    string out="{\"version\":\"1\",\"active\":"+quoteJson(chats.empty()?"":chats[selectedChat].id);
    out+=",\"model\":"+quoteJson(preferredModel)+",\"fast\":"+quoteJson(fastMode?"1":"0")+",\"chats\":[";
    bool firstChat=true;
    for(const auto& c:chats){
        if(!firstChat)out+=',';
        firstChat=false;
        out+="{\"id\":"+quoteJson(c.id)+",\"title\":"+quoteJson(c.title)+",\"draft\":"+quoteJson(c.draft)+",\"draftImage\":"+quoteJson(c.draftImage)+",\"editIndex\":"+quoteJson(std::to_string(c.editIndex))+",\"turns\":[";
        bool firstTurn=true;
        for(const auto& t:c.turns){
            if(!firstTurn)out+=',';
            firstTurn=false;
            out+="{\"question\":"+quoteJson(t.question)+",\"answer\":"+quoteJson(t.answer);
            out+=",\"model\":"+quoteJson(t.model)+",\"time\":"+quoteJson(t.time);
            out+=",\"state\":"+quoteJson(t.state)+",\"image\":"+quoteJson(t.image)+",\"content\":"+dumpJson(t.content);
            out+=",\"replyIndex\":"+quoteJson(std::to_string(t.replyIndex))+",\"replies\":[";
            for(size_t i=0;i<t.replies.size();++i){if(i)out+=',';out+=replyJson(t.replies[i]);}out+="]}";
        }
        out+="]}";
    }
    return out+"]}";
}
struct HistoryData {std::vector<Chat> chats;size_t selected=0;string model="AUTO";bool fast=true;};
HistoryData decodeHistory(const string& data){
    json root=json::parse(data);
    if(root.value("version",string())!="1"||!root.contains("chats")||root.at("chats").type!=json::Array)
        throw std::runtime_error("Định dạng lịch sử không hỗ trợ.");
    HistoryData result;auto& loaded=result.chats;std::set<string> ids;
    for(const auto& c:root.at("chats")){
        Chat item;item.id=c.at("id").str();item.title=c.at("title").str();item.draft=c.value("draft",string());item.draftImage=c.value("draftImage",string());
        string edit=c.value("editIndex",string("-1"));size_t used=0;item.editIndex=std::stoi(edit,&used);if(used!=edit.size()||item.editIndex< -1)throw std::runtime_error("Chỉ số sửa câu hỏi không hợp lệ.");
        if(item.id.empty()||c.at("turns").type!=json::Array)throw std::runtime_error("Lịch sử không hợp lệ.");
        if(!ids.insert(item.id).second)throw std::runtime_error("Lịch sử bị trùng ID.");
        for(const auto& v:c.at("turns")){
            Turn t;t.question=v.at("question").str();t.answer=v.at("answer").str();
            t.image=v.value("image",string());t.model=v.value("model",string());t.time=v.value("time",string());t.state=v.value("state",string("error"));
            if(v.contains("content"))t.content=v.at("content");
            if(v.contains("replies")){
                for(const auto& r:v.at("replies")){ReplyVersion reply;reply.answer=r.at("answer").str();reply.model=r.value("model",string());reply.state=r.at("state").str();if(!validReplyState(reply.state))throw std::runtime_error("Trạng thái phiên bản không hợp lệ.");if(r.contains("content"))reply.content=r.at("content");t.replies.push_back(std::move(reply));}
                string index=v.value("replyIndex",string("0"));size_t usedIndex=0;
                if(index.empty()||index.find_first_not_of("0123456789")!=string::npos)throw std::runtime_error("Chỉ số phiên bản không hợp lệ.");
                unsigned long long indexValue=std::stoull(index,&usedIndex);
                if(usedIndex!=index.size()||(t.replies.empty()?indexValue!=0:indexValue>=t.replies.size()))throw std::runtime_error("Chỉ số phiên bản không hợp lệ.");
                t.replyIndex=(size_t)indexValue;
            }
            if(t.state=="pending"){t.state="interrupted";t.answer="Yêu cầu bị gián đoạn trước khi lưu xong kết quả.";if(!t.replies.empty())rememberReply(t);}
            else if(!t.replies.empty())chooseReply(t,t.replyIndex);
            item.turns.push_back(std::move(t));
        }
        if(item.editIndex>=0&&(size_t)item.editIndex>=item.turns.size())item.editIndex=-1;
        loaded.push_back(item);
    }
    string active=root.value("active",string());
    for(size_t i=0;i<loaded.size();++i)if(loaded[i].id==active)result.selected=i;
    result.model=root.value("model",string("AUTO"));result.fast=root.value("fast",string("1"))!="0";
    return result;
}
void parseHistory(const string& data){
    HistoryData result=decodeHistory(data);chats.swap(result.chats);selectedChat=result.selected;
    preferredModel=result.model;fastMode=result.fast;if(chats.empty())newChat();
}
void mergeImportedHistory(HistoryData& restored,const std::function<void()>& persist){
    size_t count=restored.chats.size(),oldSize=chats.size(),oldSelected=selectedChat;
    try{
        for(auto& c:restored.chats)chats.push_back(std::move(c));
        if(count)selectedChat=oldSize+std::min(restored.selected,count-1);
        persist();
    }catch(...){chats.resize(oldSize);selectedChat=oldSelected;throw;}
}
void saveHistory(){
    static string lastSaved;
    if(!historyWritable)throw std::runtime_error("Chưa thể lưu lịch sử; kiểm tra thư mục dữ liệu.");
    string data=historyJson();
    if(data.size()>64*1024*1024)throw std::runtime_error("Lịch sử vượt 64 MB. Hãy xóa các hội thoại cũ.");
    wstring path=appDir+L"\\history.json",temp=appDir+L"\\history.tmp",backup=appDir+L"\\history.bak";
    if(data==lastSaved&&GetFileAttributesW(path.c_str())!=INVALID_FILE_ATTRIBUTES)return;
    {
        FileHandle f(CreateFileW(temp.c_str(),GENERIC_WRITE,0,nullptr,CREATE_ALWAYS,FILE_ATTRIBUTE_NORMAL,nullptr));
        if(f.h==INVALID_HANDLE_VALUE)throw winError("Không tạo được file lịch sử tạm");
        DWORD written=0;
        if(!WriteFile(f.h,data.data(),(DWORD)data.size(),&written,nullptr)||written!=data.size()||!FlushFileBuffers(f.h))
            throw winError("Không ghi được lịch sử");
    }
    BOOL ok=GetFileAttributesW(path.c_str())!=INVALID_FILE_ATTRIBUTES
        ?ReplaceFileW(path.c_str(),temp.c_str(),backup.c_str(),0,nullptr,nullptr)
        :MoveFileExW(temp.c_str(),path.c_str(),MOVEFILE_WRITE_THROUGH);
    if(!ok)throw winError("Không thay được file lịch sử; bản cũ vẫn được giữ");
    lastSaved.swap(data);
}
