// JSON reader with Unicode escape and surrogate-pair support.
struct json {
    enum Type { Null, Object, Array, String, Number, Boolean } type=Null;
    std::map<string,json> object;
    std::vector<json> array;
    string text;
    bool flag=false;
    bool contains(const string& k)const{return type==Object && object.count(k)!=0;}
    const json& at(const string& k)const {
        if(!contains(k))throw std::runtime_error("JSON missing field: "+k);
        return object.at(k);
    }
    const json& at(int i)const {
        if(type!=Array || i<0 || (size_t)i>=array.size())throw std::runtime_error("Invalid JSON array");
        return array[(size_t)i];
    }
    bool empty()const{
        if(type==Array)return array.empty();
        if(type==Object)return object.empty();
        if(type==String)return text.empty();
        return type==Null;
    }
    string str()const {
        if(type!=String)throw std::runtime_error("Expected JSON string");
        return text;
    }
    string value(const string& k,const string& fallback)const{return contains(k) && at(k).type==String?at(k).text:fallback;}
    bool value(const string& k,bool fallback)const {
        if(!contains(k)||at(k).type!=Boolean)return fallback;
        return at(k).flag;
    }
    bool operator==(const char* s)const{return type==String && text==s;}
    std::vector<json>::const_iterator begin()const {
        if(type!=Array)throw std::runtime_error("Expected JSON array");
        return array.begin();
    }
    std::vector<json>::const_iterator end()const{return array.end();}
    static json parse(const string& s);
};
struct JsonReader {
    const string& src;size_t pos=0;
    explicit JsonReader(const string& s):src(s){}
    void fail()const{throw std::runtime_error("Invalid JSON response at byte "+std::to_string(pos));}
    void space(){while(pos<src.size() && (src[pos]==' '||src[pos]=='\t'||src[pos]=='\r'||src[pos]=='\n'))++pos;}
    bool take(char c){space();if(pos<src.size()&&src[pos]==c){++pos;return true;}return false;}
    void need(char c){if(!take(c))fail();}
    uint32_t hex4(){
        uint32_t n=0;
        for(int i=0;i<4;++i){
            if(pos>=src.size())fail();
            char c=src[pos++];int v=c>='0'&&c<='9'?c-'0':c>='a'&&c<='f'?c-'a'+10:c>='A'&&c<='F'?c-'A'+10:-1;
            if(v<0)fail();
            n=n*16+(uint32_t)v;
        }return n;
    }
    void appendUtf8(string& s,uint32_t c){
        if(c<0x80)s+=(char)c;
        else if(c<0x800){s+=(char)(0xC0|(c>>6));s+=(char)(0x80|(c&63));}
        else if(c<0x10000){s+=(char)(0xE0|(c>>12));s+=(char)(0x80|((c>>6)&63));s+=(char)(0x80|(c&63));}
        else {s+=(char)(0xF0|(c>>18));s+=(char)(0x80|((c>>12)&63));s+=(char)(0x80|((c>>6)&63));s+=(char)(0x80|(c&63));}
    }
    string stringValue(){
        need('"');string s;
        while(pos<src.size()){
            unsigned char c=src[pos++];
            if(c=='"')return s;
            if(c<32)fail();
            if(c!='\\'){s+=(char)c;continue;}
            if(pos>=src.size())fail();
            char e=src[pos++];
            switch(e){
                case '"':s+='"';break;case '\\':s+='\\';break;case '/':s+='/';break;
                case 'b':s+='\b';break;case 'f':s+='\f';break;case 'n':s+='\n';break;
                case 'r':s+='\r';break;case 't':s+='\t';break;
                case 'u':{
                    uint32_t cp=hex4();
                    if(cp>=0xD800 && cp<=0xDBFF){
                        if(pos+2>src.size() || src[pos]!='\\' || src[pos+1]!='u')fail();
                        pos+=2;uint32_t low=hex4();
                        if(low<0xDC00 || low>0xDFFF)fail();
                        cp=0x10000+((cp-0xD800)<<10)+(low-0xDC00);
                    }else if(cp>=0xDC00 && cp<=0xDFFF)fail();
                    appendUtf8(s,cp);break;
                }
                default:fail();
            }
        }fail();return {};
    }
    bool digit()const{return pos<src.size() && src[pos]>='0'&&src[pos]<='9';}
    json read(int depth=0){
        if(depth>64)fail();
        space();if(pos>=src.size())fail();json j;char c=src[pos];
        if(c=='{'){
            ++pos;j.type=json::Object;if(take('}'))return j;
            do{string k=stringValue();need(':');j.object[k]=read(depth+1);}while(take(','));
            need('}');return j;
        }
        if(c=='['){
            ++pos;j.type=json::Array;if(take(']'))return j;
            do{j.array.push_back(read(depth+1));}while(take(','));
            need(']');return j;
        }
        if(c=='"'){j.type=json::String;j.text=stringValue();return j;}
        if(src.compare(pos,4,"null")==0){pos+=4;return j;}
        if(src.compare(pos,4,"true")==0){pos+=4;j.type=json::Boolean;j.flag=true;return j;}
        if(src.compare(pos,5,"false")==0){pos+=5;j.type=json::Boolean;return j;}
        size_t start=pos;
        if(src[pos]=='-')++pos;
        if(!digit())fail();
        if(src[pos]=='0')++pos;else while(digit())++pos;
        if(pos<src.size()&&src[pos]=='.'){++pos;if(!digit())fail();
            while(digit())++pos;}
        if(pos<src.size()&&(src[pos]=='e'||src[pos]=='E')){
            ++pos;if(pos<src.size()&&(src[pos]=='+'||src[pos]=='-'))++pos;
            if(!digit())fail();
            while(digit())++pos;
        }
        j.type=json::Number;j.text=src.substr(start,pos-start);return j;
    }
};
json json::parse(const string& s){
    JsonReader r(s);
    if(s.size()>=3 && (unsigned char)s[0]==0xEF && (unsigned char)s[1]==0xBB && (unsigned char)s[2]==0xBF)r.pos=3;
    json j=r.read();r.space();if(r.pos!=s.size())r.fail();return j;
}
string quoteJson(const string& s){
    string out="\"";const char* hex="0123456789abcdef";
    for(unsigned char c:s){
        if(c=='"')out+="\\\"";
        else if(c=='\\')out+="\\\\";
        else if(c<32){out+="\\u00";out+=hex[c>>4];out+=hex[c&15];}
        else out+=(char)c;
    }return out+'"';
}


