        try{
            response=http(j,L"POST",L"/v1beta/models/"+wide(model)+L":streamGenerateContent?alt=sse",requestBody(j,model,retry,version),[&](const string& b){sse.feed(b);});
            if(response.code>=200&&response.code<300){if(response.streamed)sse.end();else state.consume(json::parse(response.body));publishNew();}
        }catch(const std::exception& e){
            client.reset();
            if(!state.hasText())throw;
            j.answer=state.text+"\n\n[Phản hồi bị gián đoạn: "+string(e.what())+"]";j.complete=false;j.content=state.content();return;
        }
        if(response.code<200||response.code>=300){
            last=apiError(response);
            if(response.code==404 && automatic && !refreshed){j.names=loadModels(j);j.lastGood.clear();choices=choicesFor(j);choice=0;refreshed=true;retry=false;version.clear();continue;}
            bool temporary=response.code==500||response.code==502||response.code==503||response.code==504;
            if(!temporary && !(response.code==404&&automatic))throw std::runtime_error(last);
        }else{
            version=state.version;j.actualVersion=version;
            if(state.hasText()){
                j.answer=state.text;j.complete=state.success();j.content=state.content();
                if(!j.complete)j.answer+="\n\n[Phản hồi chưa đầy đủ: "+state.diagnostic()+"]";
                return;
            }
            last="API không trả văn bản. Model: "+model+"\n"+state.diagnostic();
            if(!state.retryable())throw std::runtime_error(last);
        }
        if(retry || response.code==404){++choice;retry=false;version.clear();}else retry=true;
        if(choice>=choices.size()&&automatic&&!refreshed&&j.names.empty()&&total<3){
            j.names=loadModels(j);j.lastGood.clear();choices=choicesFor(j);
            choices.erase(std::remove(choices.begin(),choices.end(),model),choices.end());
            choice=0;refreshed=true;version.clear();
        }
        if(choice<choices.size() && total<3 && WaitForSingleObject(j.cancel,800)==WAIT_OBJECT_0)checkCancel(j);
    }
    throw std::runtime_error(last+"\nĐã dừng sau số lần thử giới hạn.");
}
unsigned __stdcall runJob(void* ptr){
    Job& j=*static_cast<Job*>(ptr);
    try{
        if(j.list){j.names=loadModels(j);j.publish(L"Đã cập nhật danh sách model.",L"");}
        else generate(j);
        j.ok=true;
    }catch(const std::exception& e){
        client.reset();
        j.error=WaitForSingleObject(j.cancel,0)==WAIT_OBJECT_0?"Đã dừng yêu cầu.":e.what();
    }catch(...){j.error="Lỗi không xác định.";}
    for(string* value:{&j.answer,&j.error})for(size_t p=0;!j.key.empty()&&(p=value->find(j.key,p))!=string::npos;p+=9)value->replace(p,j.key.size(),"[API KEY]");
    if(!j.key.empty())SecureZeroMemory(&j.key[0],j.key.size());
    j.key.clear();return 0;
}

