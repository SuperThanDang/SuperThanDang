        SendMessageW(outputEdit,EM_SETCHARFORMAT,SCF_SELECTION,(LPARAM)&plain);
        SendMessageW(outputEdit,EM_SETREADONLY,FALSE,0);
        SendMessageW(outputEdit,EM_REPLACESEL,FALSE,(LPARAM)value.c_str());
        SendMessageW(outputEdit,EM_SETREADONLY,TRUE,0);
    }else SetWindowTextW(outputEdit,value.c_str());
    outputEndsWithCR=!s.empty()&&s.back()==L'\r';
    if(append&&!follow&&unreadUpdates<1000000)++unreadUpdates;
