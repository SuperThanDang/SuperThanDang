// Reuse one bounded surface; ordinary repaints only copy the invalid rectangle.
struct SurfaceCache {
    HDC dc=nullptr;HBITMAP bitmap=nullptr;HGDIOBJ original=nullptr;
    int width=0,height=0,viewWidth=0,viewHeight=0;bool dirty=true;
    void clear(){if(dc&&original)SelectObject(dc,original);if(bitmap)DeleteObject(bitmap);if(dc)DeleteDC(dc);dc=nullptr;bitmap=nullptr;original=nullptr;width=height=viewWidth=viewHeight=0;dirty=true;}
    bool ensure(HDC target,int w,int h){
        if(w<=0||h<=0||(uint64_t)w*(uint64_t)h>16*1024*1024){clear();return false;}
        if(dc&&w<=width&&h<=height){
            if(viewWidth!=w||viewHeight!=h)dirty=true;
            viewWidth=w;viewHeight=h;return true;
        }
        clear();
        int capacityW=((w+127)/128)*128,capacityH=((h+127)/128)*128;
        if((uint64_t)capacityW*capacityH>16*1024*1024){capacityW=w;capacityH=h;}
        dc=CreateCompatibleDC(target);if(!dc)return false;
        bitmap=CreateCompatibleBitmap(target,capacityW,capacityH);if(!bitmap){clear();return false;}
        original=SelectObject(dc,bitmap);if(!original||original==HGDI_ERROR){original=nullptr;clear();return false;}
        width=capacityW;height=capacityH;viewWidth=w;viewHeight=h;return true;
    }
} surfaceCache;
void paintBuffered(HDC dc,const RECT& update){
    RECT bounds;GetClientRect(mainWnd,&bounds);
    if(!surfaceCache.ensure(dc,bounds.right,bounds.bottom)){paintSurface(dc);return;}
    if(surfaceCache.dirty){paintSurface(surfaceCache.dc);surfaceCache.dirty=false;}
    if(!BitBlt(dc,update.left,update.top,update.right-update.left,update.bottom-update.top,surfaceCache.dc,update.left,update.top,SRCCOPY))paintSurface(dc);
}
