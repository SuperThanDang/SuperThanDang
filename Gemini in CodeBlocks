            if(msg.message==WM_KEYDOWN&&msg.wParam==VK_RETURN&&(GetKeyState(VK_CONTROL)&0x8000)&&GetFocus()==promptEdit){SendMessageW(mainWnd,WM_COMMAND,SEND,0);continue;}
