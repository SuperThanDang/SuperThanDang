string trim(string s) {
    auto start=s.find_first_not_of(" \t\r\n\"'");
    if(start==string::npos) return {};
    return s.substr(start,s.find_last_not_of(" \t\r\n\"'")-start+1);
}
bool validIdentifier(const string& s) {
    return !s.empty() && std::all_of(s.begin(),s.end(),[](unsigned char c){
        return (c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='-'||c=='_'||c=='.';
    });
}

wstring clipboardText() {
    if(!OpenClipboard(mainWnd)) throw winError("Không mở được Clipboard");
    struct Guard { ~Guard(){CloseClipboard();} } guard;
    HANDLE data=GetClipboardData(CF_UNICODETEXT);
    if(!data) throw std::runtime_error("Clipboard không có văn bản. Hãy nhấn Ctrl+C trước.");
    auto p=static_cast<const wchar_t*>(GlobalLock(data));
    if(!p) throw winError("Không đọc được Clipboard");
    size_t count=GlobalSize(data)/sizeof(wchar_t), n=0;
    while(n<count && p[n]) ++n;
    wstring result(p,n); GlobalUnlock(data); return result;
}
void copyText(const wstring& s) {
    size_t bytes=(s.size()+1)*sizeof(wchar_t);
    HGLOBAL mem=GlobalAlloc(GMEM_MOVEABLE,bytes);
    if(!mem) throw winError("Không cấp được bộ nhớ Clipboard");
    void* p=GlobalLock(mem);
    if(!p){GlobalFree(mem);throw winError("Không ghi được Clipboard");}
    memcpy(p,s.c_str(),bytes); GlobalUnlock(mem);
    if(!OpenClipboard(mainWnd)){GlobalFree(mem);throw winError("Clipboard đang bận");}
    if(!EmptyClipboard() || !SetClipboardData(CF_UNICODETEXT,mem)) {
        DWORD e=GetLastError(); CloseClipboard();GlobalFree(mem);throw winError("Không sao chép được",e);
    }
    CloseClipboard(); // Windows now owns mem.
}
void saveKey(const string& key) {
    if(key.size()>CRED_MAX_CREDENTIAL_BLOB_SIZE) throw std::runtime_error("API key quá dài.");
    CREDENTIALW c{};
    c.Type=CRED_TYPE_GENERIC;
    c.TargetName=const_cast<LPWSTR>(CREDENTIAL_TARGET);
    c.UserName=const_cast<LPWSTR>(L"Gemini API");
    c.CredentialBlobSize=(DWORD)key.size();
    c.CredentialBlob=(LPBYTE)key.data();
    c.Persist=CRED_PERSIST_LOCAL_MACHINE;
    if(!CredWriteW(&c,0)) throw winError("Không lưu được key vào Windows Credential Manager");
}
string loadKey() {
    PCREDENTIALW c=nullptr;
    if(CredReadW(CREDENTIAL_TARGET,CRED_TYPE_GENERIC,0,&c)) {
        string s((char*)c->CredentialBlob,c->CredentialBlobSize);CredFree(c);return s;
    }
    wchar_t value[4096]{};
    DWORD n=GetEnvironmentVariableW(L"GEMINI_API_KEY",value,4096);
    return n>0 && n<4096 ? utf8(value) : string();
}

string base64(const std::vector<uint8_t>& bytes) {
    static const char table[]="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    string r; r.reserve((bytes.size()+2)/3*4);
    for(size_t i=0;i<bytes.size();i+=3) {
        uint32_t x=uint32_t(bytes[i])<<16;
        if(i+1<bytes.size()) x|=uint32_t(bytes[i+1])<<8;
        if(i+2<bytes.size()) x|=bytes[i+2];
        r+=table[(x>>18)&63];r+=table[(x>>12)&63];
        r+=i+1<bytes.size()?table[(x>>6)&63]:'=';
        r+=i+2<bytes.size()?table[x&63]:'=';
    }
    return r;
}


