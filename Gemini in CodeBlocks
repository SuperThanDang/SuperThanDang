    if(follow){if(!append)selectOutputEnd();SendMessageW(outputEdit,EM_SCROLLCARET,0,0);}
    else{SendMessageW(outputEdit,EM_SETSEL,a,b);SendMessageW(outputEdit,EM_SETSCROLLPOS,0,(LPARAM)&scroll);}
    if(visible){SendMessageW(outputEdit,WM_SETREDRAW,TRUE,0);RedrawWindow(outputEdit,nullptr,nullptr,RDW_INVALIDATE|RDW_ERASE|RDW_FRAME);}
    updateBottom();
}
