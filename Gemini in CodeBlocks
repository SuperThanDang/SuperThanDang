}

void initDataDirectory(){
    wchar_t path[32768]{};DWORD n=GetEnvironmentVariableW(L"LOCALAPPDATA",path,32768);
    if(!n||n>=32768)throw std::runtime_error("Không tìm thấy LOCALAPPDATA.");
    appDir=wstring(path)+L"\\GeminiDesktop";
    if(!CreateDirectoryW(appDir.c_str(),nullptr)&&GetLastError()!=ERROR_ALREADY_EXISTS)throw winError("Không tạo được thư mục GeminiDesktop");
}
void copyRuntimeLibraries(){
    for(const wchar_t* name:{L"libstdc++-6.dll",L"libgcc_s_seh-1.dll",L"libgcc_s_dw2-1.dll",L"libgcc_s_sjlj-1.dll",L"libwinpthread-1.dll"}){
        HMODULE m=GetModuleHandleW(name);if(!m)continue;wchar_t path[32768]{};
        DWORD n=GetModuleFileNameW(m,path,32768);if(!n||n>=32768)throw winError("Không đọc được đường dẫn thư viện MinGW");
        wstring target=appDir+L"\\"+name;
        if(_wcsicmp(path,target.c_str())!=0&&!CopyFileW(path,target.c_str(),FALSE))throw winError("Không sao chép được thư viện MinGW cho bản chạy nền");
    }
}
unsigned buildToken(){
    unsigned value=2166136261u;
    const char* stamp="GeminiDesk14 " __DATE__ " " __TIME__;
    for(const unsigned char* p=(const unsigned char*)stamp;*p;++p)value=(value^*p)*16777619u;
    return (value&0x7fffffffu)|1u;
}
bool reuseRunningApp(HWND existing){
    if(!existing)return false;
    DWORD_PTR version=0;
    if(!SendMessageTimeoutW(existing,WM_APP+20,0,0,SMTO_ABORTIFHUNG|SMTO_BLOCK,2000,&version))
        throw std::runtime_error("Ứng dụng cũ chưa phản hồi. Hãy mở bản cũ và thoát bằng Alt+Q rồi chạy lại.");
    if(version==buildToken()){
        if(!PostMessageW(existing,WM_SHOW_APP,0,0))throw winError("Không mở lại được cửa sổ");
        return true;
    }
    HWND prompt=GetDlgItem(existing,PROMPT);DWORD_PTR draftLength=0;
    if(prompt){
        if(!SendMessageTimeoutW(prompt,WM_GETTEXTLENGTH,0,0,SMTO_ABORTIFHUNG|SMTO_BLOCK,2000,&draftLength))
            throw std::runtime_error("Chưa đọc được trạng thái bản nháp của ứng dụng cũ. Hãy thoát bản cũ bằng Alt+Q.");
        if(draftLength){
            PostMessageW(existing,WM_SHOW_APP,0,0);
            throw std::runtime_error("Bản giao diện cũ còn nội dung chưa gửi. Hãy sao chép nội dung cần giữ, thoát bản cũ bằng Alt+Q rồi F9 lại để mở giao diện mới.");
        }
    }
    DWORD pid=0;GetWindowThreadProcessId(existing,&pid);
    FileHandle oldProcess(OpenProcess(SYNCHRONIZE,FALSE,pid));
    if(!oldProcess.h)throw winError("Không theo dõi được phiên bản cũ");
    if(!PostMessageW(existing,WM_COMMAND,QUIT,0))throw winError("Không yêu cầu thoát được phiên bản cũ");
    DWORD result=WaitForSingleObject(oldProcess.h,8000);
    if(result==WAIT_OBJECT_0)return false;
    if(result==WAIT_FAILED)throw winError("Không xác nhận được phiên bản cũ đã thoát");
    PostMessageW(existing,WM_SHOW_APP,0,0);
    throw std::runtime_error("Đã yêu cầu bản cũ lưu dữ liệu và thoát. Nếu bản cũ đang gửi yêu cầu hoặc có hộp thoại lưu, hãy chờ hoàn tất rồi F9 lại.");
}

int launchDetached(){
    FileHandle gate(CreateMutexW(nullptr,FALSE,L"Local\\GeminiDesktopV4Launcher"));
    if(!gate.h)throw winError("Không tạo được launcher mutex");
    DWORD waited=WaitForSingleObject(gate.h,10000);
    if(waited!=WAIT_OBJECT_0&&waited!=WAIT_ABANDONED)throw std::runtime_error("Một bản Gemini khác đang khởi động.");
    struct Unlock{HANDLE h;~Unlock(){ReleaseMutex(h);}} unlock{gate.h};
    HWND existing=FindWindowW(CLASS_NAME,nullptr);
    if(reuseRunningApp(existing))return 0;
    wchar_t source[32768]{};DWORD n=GetModuleFileNameW(nullptr,source,32768);
    if(!n||n>=32768)throw winError("Không đọc được đường dẫn chương trình");
    wstring target=appDir+L"\\GeminiDesktop.exe",temp=appDir+L"\\GeminiDesktop.new.exe";
    if(_wcsicmp(source,target.c_str())!=0){
        if(!CopyFileW(source,temp.c_str(),FALSE)||!MoveFileExW(temp.c_str(),target.c_str(),MOVEFILE_REPLACE_EXISTING|MOVEFILE_WRITE_THROUGH))
            throw winError("Không cập nhật được bản chạy nền. Hãy Thoát hẳn bản cũ rồi F9 lại");
    }
    copyRuntimeLibraries();
    FileHandle ready(CreateEventW(nullptr,TRUE,FALSE,L"Local\\GeminiDesktopV4Ready"));
    if(!ready.h)throw winError("Không tạo được ready event");
    ResetEvent(ready.h);
    wstring command=L"\""+target+L"\" --background";
    std::vector<wchar_t> buffer(command.begin(),command.end());buffer.push_back(0);
    STARTUPINFOW si{};si.cb=sizeof(si);PROCESS_INFORMATION pi{};
    DWORD flags=DETACHED_PROCESS|CREATE_NEW_PROCESS_GROUP|CREATE_BREAKAWAY_FROM_JOB;
    BOOL ok=CreateProcessW(target.c_str(),buffer.data(),nullptr,nullptr,FALSE,flags,nullptr,appDir.c_str(),&si,&pi);
    if(!ok&&GetLastError()==ERROR_ACCESS_DENIED){
        buffer.assign(command.begin(),command.end());buffer.push_back(0);
        ok=CreateProcessW(target.c_str(),buffer.data(),nullptr,nullptr,FALSE,DETACHED_PROCESS|CREATE_NEW_PROCESS_GROUP,nullptr,appDir.c_str(),&si,&pi);
    }
    if(!ok)throw winError("Không khởi động được tiến trình độc lập");
    CloseHandle(pi.hThread);FileHandle process(pi.hProcess);HANDLE waits[]={ready.h,process.h};
    DWORD result=WaitForMultipleObjects(2,waits,FALSE,10000);
    if(result==WAIT_FAILED)throw winError("Không theo dõi được tiến trình chạy nền");
    if(result==WAIT_TIMEOUT)throw std::runtime_error("Chưa xác nhận được giao diện sau 10 giây. Kiểm tra ứng dụng ở khay hệ thống trước khi chạy lại.");
    if(result==WAIT_OBJECT_0+1)throw std::runtime_error("Ứng dụng chạy nền đã thoát khi khởi tạo.");
    return 0;
}
