void prepareConversation(Job& next,const std::function<void()>& persist){
        size_t sourceIndex=selectedChat;int editIndex=chats[sourceIndex].editIndex;
        string sourceDraft=chats[sourceIndex].draft,sourceImage=chats[sourceIndex].draftImage;
        bool forked=editIndex>=0;
        if(forked){Chat branch=editedBranch(chats[sourceIndex],(size_t)editIndex);chats.push_back(std::move(branch));selectedChat=chats.size()-1;}
        Chat& c=chats[selectedChat];next.chatId=c.id;next.turnIndex=c.turns.size();
        string oldTitle=c.title,oldDraft=c.draft,oldImage=c.draftImage;int oldEdit=c.editIndex;bool pushed=false;
        try{
            for(auto it=c.turns.rbegin();it!=c.turns.rend()&&next.context.size()<6;++it)if(it->state=="ok")next.context.push_back(contextTurn(*it));
            std::reverse(next.context.begin(),next.context.end());
            Turn t;t.question=next.prompt;t.image=next.originalImage;t.time=nowText();
            if(c.turns.empty()){
                wstring title=wide(next.prompt);if(title.size()>45)title.resize(45);
                if(!title.empty()&&title.back()>=0xD800&&title.back()<=0xDBFF)title.pop_back();
                c.title=utf8(title);
            }
            c.turns.push_back(std::move(t));pushed=true;c.draft.clear();c.draftImage.clear();c.editIndex=-1;
            if(forked){chats[sourceIndex].draft.clear();chats[sourceIndex].draftImage.clear();chats[sourceIndex].editIndex=-1;}
            persist();
        }catch(...){
            if(pushed)c.turns.pop_back();
            c.title=oldTitle;c.draft=oldDraft;c.draftImage=oldImage;c.editIndex=oldEdit;
            if(forked){chats.pop_back();selectedChat=sourceIndex;chats[sourceIndex].draft=sourceDraft;chats[sourceIndex].draftImage=sourceImage;chats[sourceIndex].editIndex=editIndex;}
            throw;
        }
}

// Retrying an earlier turn creates a branch. Later context and drafts stay in the source chat.
void prepareRetry(Job& next,size_t index,const std::function<void()>& persist){
    size_t source=selectedChat;if(index>=chats[source].turns.size())throw std::runtime_error("Câu hỏi không còn tồn tại.");
    Turn previous=chats[source].turns[index];
    bool branch=index+1<chats[source].turns.size();
    if(branch){Chat c;c.id=newId();c.title=chats[source].title+" · trả lời lại";c.turns.assign(chats[source].turns.begin(),chats[source].turns.begin()+index+1);chats.push_back(std::move(c));selectedChat=chats.size()-1;}
    try{
        auto& c=chats[selectedChat];auto& t=c.turns[index];
        if(t.replies.empty())rememberReply(t);
        for(size_t i=index;i>0&&next.context.size()<6;--i)if(c.turns[i-1].state=="ok")next.context.push_back(contextTurn(c.turns[i-1]));
        std::reverse(next.context.begin(),next.context.end());
        next.chatId=c.id;next.turnIndex=index;t.answer.clear();t.model.clear();t.content=json();t.state="pending";persist();
    }catch(...){if(branch){chats.pop_back();selectedChat=source;}else chats[source].turns[index]=std::move(previous);throw;}
}
void changeReply(size_t turn,int direction){
    if(busy||archiveBusy||closePending||turn>=chats[selectedChat].turns.size())return;
    const auto& current=chats[selectedChat].turns[turn];
    if(current.replies.size()<2)return;
    long long target=(long long)current.replyIndex+direction;
    if(target<0||target>=(long long)current.replies.size())return;
    size_t source=selectedChat;bool branch=turn+1<chats[source].turns.size();
    Turn previous=current;
    if(branch){Chat c;c.id=newId();c.title=chats[source].title+" · phiên bản";c.turns.assign(chats[source].turns.begin(),chats[source].turns.begin()+turn+1);chats.push_back(std::move(c));selectedChat=chats.size()-1;}
    try{chooseReply(chats[selectedChat].turns[turn],(size_t)target);saveHistory();historyWarning.clear();}
    catch(...){if(branch){chats.pop_back();selectedChat=source;}else chats[source].turns[turn]=std::move(previous);throw;}
    if(branch)SetWindowTextW(GetDlgItem(mainWnd,SEARCH),L"");
    refreshChats();showHistory(false);status(branch?L"Đã mở nhánh từ phiên bản này; hội thoại cũ được giữ nguyên.":L"Đã chuyển phiên bản trả lời.");
}
void start(bool list=false,int retryIndex=-1){
    if(busy||archiveBusy||closePending)return;
    std::unique_ptr<Job> next(new Job);
    if(!next->cancel)throw winError("Không tạo được worker event");
    next->key=checkedKey();next->list=list;next->retrying=retryIndex>=0;
    if(next->retrying&&(size_t)retryIndex>=chats[selectedChat].turns.size())throw std::runtime_error("Câu hỏi không còn tồn tại.");
    next->model=trim(utf8(readText(modelCombo)));
    if(next->model.compare(0,7,"models/")==0)next->model.erase(0,7);
    if(next->model.empty())next->model="AUTO";
    if(!list&&next->model!="AUTO"&&!textModel(next->model))throw std::runtime_error("Chọn AUTO hoặc model Gemini văn bản.");
    next->fast=SendMessageW(fastCheck,BM_GETCHECK,0,0)==BST_CHECKED;
    preferredModel=next->model;fastMode=next->fast;
    if(cacheKey!=next->key){cachedModels.clear();lastGoodModel.clear();cacheTime=0;cacheKey=next->key;}
    if(GetTickCount64()-cacheTime<15*60*1000)next->names=cachedModels;
    if(lastFast==next->fast)next->lastGood=lastGoodModel;
    next->prompt=next->retrying?editableQuestion(chats[selectedChat].turns[(size_t)retryIndex]):utf8(readText(promptEdit));next->originalDraft=next->prompt;
    if(next->retrying){const auto& t=chats[selectedChat].turns[(size_t)retryIndex];if(t.image.empty()&&next->prompt!=t.question)throw std::runtime_error("Ảnh của lượt chat cũ chưa được lưu. Hãy chọn Sửa & gửi lại rồi đính kèm ảnh.");}
    if(!list){
        next->originalImage=next->retrying?chats[selectedChat].turns[(size_t)retryIndex].image:chats[selectedChat].draftImage;
        if(!next->originalImage.empty()){
            string png=readFile(imagePath(next->originalImage));
            if(png.size()>16*1024*1024)throw std::runtime_error("Ảnh đính kèm quá lớn. Hãy chọn lại.");
            next->image=base64(std::vector<uint8_t>(png.begin(),png.end()));
        }
        if(next->prompt.find_first_not_of(" \t\r\n")==string::npos){
            if(next->image.empty())throw std::runtime_error("Nhập câu hỏi hoặc đính kèm ảnh trước khi gửi.");
            next->prompt="Hãy đọc và giải thích nội dung ảnh bằng tiếng Việt. Nếu có bài tập, hãy giải từng bước.";
        }
        bool branching=next->retrying?(size_t)retryIndex+1<chats[selectedChat].turns.size():chats[selectedChat].editIndex>=0;
        if(next->retrying)prepareRetry(*next,(size_t)retryIndex,[](){saveHistory();historyWarning.clear();});
        else prepareConversation(*next,[](){saveHistory();historyWarning.clear();});
        KillTimer(mainWnd,2);
        if(branching)SetWindowTextW(GetDlgItem(mainWnd,SEARCH),L"");
        refreshChats();showHistory();
    }
    secondPoint=false;liveStarted=false;job=std::move(next);setBusy(true);
    if(!SetTimer(mainWnd,1,50,nullptr)){job->error="Không tạo được UI timer.";finishJob();throw std::runtime_error("Không tạo được UI timer.");}
    worker=(HANDLE)_beginthreadex(nullptr,0,runJob,job.get(),0,nullptr);
    if(!worker){job->error="Không tạo được luồng mạng.";finishJob();throw std::runtime_error("Không tạo được luồng mạng.");}
    status(list?L"Đang tải model...":L"Đang nhận câu trả lời… Markdown được định dạng khi hoàn tất.");
}

