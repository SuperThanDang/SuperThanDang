wstring windowsLines(const wstring& s,bool precedingCR=false) {
    wstring out;
    out.reserve(s.size());
    for(size_t i=0;i<s.size();++i) {
        if(s[i]==L'\n' && (i? s[i-1]!=L'\r' : !precedingCR)) out+=L'\r';
        out+=s[i];
    }
    return out;
}
