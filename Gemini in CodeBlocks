    bool follow=force||!GetScrollInfo(outputEdit,SB_VERT,&si)||si.nPos+(int)si.nPage>=si.nMax-2;
    DWORD a=0,b=0;SendMessageW(outputEdit,EM_GETSEL,(WPARAM)&a,(LPARAM)&b);
    if(!force&&a!=b)follow=false;
    POINT scroll{};SendMessageW(outputEdit,EM_GETSCROLLPOS,0,(LPARAM)&scroll);
    bool visible=IsWindowVisible(outputEdit)!=FALSE;
    if(visible)SendMessageW(outputEdit,WM_SETREDRAW,FALSE,0);
    if(append){
        selectOutputEnd();
        CHARFORMAT2W plain{};plain.cbSize=sizeof(plain);plain.dwMask=CFM_LINK|CFM_BOLD|CFM_ITALIC|CFM_UNDERLINE|CFM_FACE|CFM_SIZE|CFM_COLOR|CFM_BACKCOLOR;
